@script {
  import { html } from '@okalit/core';
  import routes from './app.routes.js';
  import '@styles/index.css';
  import '@layouts/app-layout.js';
}

@main {
  tag: 'main-app',
  routes,
  template: (slot) => html`<app-layout>${slot}</app-layout>`,
  i18n: {
    default: 'en',
    locales: ['es', 'en'],
  },
}
